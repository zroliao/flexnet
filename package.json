{
  "name": "flexnet",
  "version": "0.1.0",
  "author": "JW Liao",
  "scripts": {
    "start": "npm run dev",
    "lint": "tslint src/**/*.ts --exclude src/**/*.d.ts",
    "dev": "nodemon --watch src/**/*.ts --ignore src/**/*.spec.ts --exec ts-node index.ts",
    "build": "node build/build-script.js",
    "run:edge": "ts-node samples/example-edge-server.ts",
    "run:signal": "ts-node samples/example-signal-server.ts",
    "build:pb:flexnet": "pbjs -t static-module -w commonjs -o src/protobuf/index.js protos/rpc.proto && pbts -o src/protobuf/index.d.ts src/protobuf/index.js",
    "build:pb:browser": "mkdirp dist-ptbf-web && pbjs --force-number -t static -w commonjs -o dist-ptbf-web/index.js protos/*.proto && pbts -o dist-ptbf-web/index.d.ts dist-ptbf-web/index.js",
    "postbuild": "cpx \"native/node-libdatachannel/0.31.0/win64/node_datachannel.node\" dist/flexnet/"
  },
  "dependencies": {
    "electron-log": "4.4.1",
    "ip": "1.1.8",
    "joi": "17.4.2",
    "mkdirp": "1.0.4",
    "moment": "2.29.1",
    "uWebSockets.js": "uNetworking/uWebSockets.js#v20.52.0",
    "ws": "8.6.0",
    "xstate": "4.26.0",
    "ping": "0.4.2",
    "protobufjs": "6.11.2",
    "@theinternetfolks/snowflake": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/ws": "8.5.3",
    "nodemon": "2.0.15",
    "shelljs": "0.8.4",
    "ts-loader": "9.2.6",
    "ts-node": "10.9.2",
    "tslint": "6.1.3",
    "typescript": "5.9.2",
    "webpack": "5.64.2",
    "cpx": "1.5.0"
  },
  "engines": {
    "node": "= 22.14.0",
    "npm": ">= 10.9.2"
  }
}
